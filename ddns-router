#!/usr/bin/env bash
# ddns-router — manage per-router TSIG keys for a self-hosted DDNS zone (BIND 9 in Docker)
#
# Source of truth: config/routers.list (one name per line).
# Generated:       config/ddns.conf (key includes + zone with update-policy) — never edit by hand.
set -euo pipefail

usage() {
  cat <<EOF
ddns-router — manage per-router TSIG keys for $ZONE

  sudo ddns-router init             create admin key, router list, generated config
  sudo ddns-router add <name>       new key + grant, reload BIND, print the router settings
  sudo ddns-router remove <name>    revoke key + grant, reload BIND, delete DNS record
  sudo ddns-router show <name>      print the router settings again
  sudo ddns-router list             routers and their current IP
EOF
  exit 1
}

BASE="${DDNS_BASE:-/var/data/containers/bind9}"
COMPOSE="$BASE/compose"
CONF="$BASE/config"
KEYDIR="$CONF/keys"
LIST="$CONF/routers.list"
GEN="$CONF/ddns.conf"
ENVF="$COMPOSE/.env"
ZONE="${DDNS_ZONE:-dyn.example.com}"   # override with DDNS_ZONE, or edit here
IMAGE="internetsystemsconsortium/bind9:9.20"
NAME_RE='^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$'

die()  { echo "error: $*" >&2; exit 1; }
warn() { echo "warning: $*" >&2; }

[ "$(id -u)" -eq 0 ] || die "run with sudo"
[ -d "$CONF" ]       || die "$CONF not found — is DDNS_BASE correct?"
[ -f "$ENVF" ]       || die "$ENVF not found"

# Read single values from .env WITHOUT executing it (this script runs as root,
# .env is user-owned). Strips CR, inline comments, surrounding quotes.
envget() {
  local v
  v=$(sed -n "s/^[[:space:]]*\(export[[:space:]]\+\)\?$1=//p" "$ENVF" | tail -n1 | tr -d '\r')
  v="${v%%#*}"
  v="${v%"${v##*[![:space:]]}"}"
  v="${v#\"}"; v="${v%\"}"; v="${v#\'}"; v="${v%\'}"
  printf '%s' "$v"
}
BIND_IP=$(envget BIND_IP)
BIND_GID=$(envget BIND_GID)
DDNS_SERVER=$(envget DDNS_SERVER)   # public IP the routers send updates to (the router field rejects hostnames)
[[ "$BIND_IP"     =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || die "BIND_IP in .env is not an IPv4 address"
[[ "$BIND_GID"    =~ ^[0-9]+$ ]]                      || die "BIND_GID in .env is not a number"
[[ "$DDNS_SERVER" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || die "DDNS_SERVER in .env must be the public IPv4 (the router field rejects hostnames)"
OWNER=$(stat -c %U "$CONF")

exec 9>/run/ddns-router.lock
flock -n 9 || die "another ddns-router is running"

# 'ddns-admin' is reserved: it is the admin key's name (router keys are named after the router)
is_valid()   { [[ "${1:-}" =~ $NAME_RE ]] && [ "$1" != ddns-admin ]; }
valid_name() { is_valid "${1:-}" || die "invalid name '${1:-}' (lowercase letters, digits, hyphens; max 50 chars; 'ddns-admin' is reserved)"; }

# The router list is user-writable and its content ends up in BIND's config:
# validate it in the main shell (a die inside $(...) or a pipe would only exit a subshell).
check_list() {
  local n
  [ -f "$LIST" ] || return 0
  while IFS= read -r n || [ -n "$n" ]; do
    n="${n%$'\r'}"
    [ -z "$n" ] && continue
    is_valid "$n" || die "routers.list contains an invalid entry: '$n' — fix the file first"
  done < "$LIST"
}
names() {  # clean list (CR and blank lines stripped); only called after check_list
  [ -f "$LIST" ] || return 0
  tr -d '\r' < "$LIST" | grep -E "$NAME_RE" | grep -vx ddns-admin || true
}
known()     { names | grep -qx -- "$1"; }
secret_of() { awk -F'"' '$1 ~ /^[[:space:]]*secret[[:space:]]*$/ {print $2; exit}' "$KEYDIR/$1.key"; }
protect()   { chown "$OWNER:$BIND_GID" "$@"; chmod 640 "$@"; }

newkey() {  # newkey <keyname> <file>
  docker run --rm --entrypoint tsig-keygen "$IMAGE" -a hmac-sha256 "$1" > "$2.tmp"
  grep -q 'secret' "$2.tmp" || { rm -f "$2.tmp"; die "tsig-keygen failed"; }
  mv "$2.tmp" "$2"; protect "$2"
}

regen() {
  local tmp all n
  all=$(names)
  tmp=$(mktemp "$CONF/.ddns.conf.XXXXXX")
  {
    echo "// GENERATED by ddns-router from routers.list — do not edit by hand"
    echo "include \"/etc/bind/keys/ddns-admin.key\";"
    for n in $all; do echo "include \"/etc/bind/keys/$n.key\";"; done
    echo
    echo "zone \"$ZONE\" {"
    echo "    type primary;"
    echo "    file \"/var/lib/bind/$ZONE.zone\";"
    echo "    update-policy {"
    echo "        grant ddns-admin. zonesub ANY;"
    for n in $all; do echo "        grant $n. name $n.$ZONE. A;"; done
    echo "    };"
    echo "};"
  } > "$tmp"
  protect "$tmp"
  mv "$tmp" "$GEN"
}

running() { (cd "$COMPOSE" && docker compose ps --status running -q bind9 2>/dev/null | grep -q .); }

# Validate + reload. config/ is a bind-mounted directory, so the running container
# sees the new files immediately and named-checkconf checks exactly what will load.
apply() {
  if ! running; then
    echo "bind9 is not running — config generated, it will load on next start"
    return 0
  fi
  (cd "$COMPOSE" && docker compose exec -T bind9 named-checkconf /etc/bind/named.conf) || return 1
  (cd "$COMPOSE" && docker compose kill -s HUP bind9 >/dev/null)
  sleep 2
  dig @"$BIND_IP" "$ZONE" SOA +short +time=2 +tries=3 | grep -q . \
    || die "bind9 not answering after reload — check: cd $COMPOSE && sudo docker compose logs bind9"
}

snapshot() { cp -p "$LIST" "$LIST.bak"; }
restore()  { mv -f "$LIST.bak" "$LIST"; regen; }
# Write the list atomically. sed (not grep) drops blank lines so an empty list
# is a success, not a pipeline failure; any real failure leaves the list untouched.
write_list() {
  local t
  t=$(mktemp "$CONF/.routers.XXXXXX") || return 1
  if ! printf '%s\n' "$@" | sed '/^$/d' | sort -u > "$t"; then rm -f "$t"; return 1; fi
  protect "$t" || { rm -f "$t"; return 1; }
  mv "$t" "$LIST"
}

cmd_init() {
  mkdir -p "$KEYDIR"
  chown "$OWNER:$BIND_GID" "$KEYDIR"; chmod 750 "$KEYDIR"
  [ -f "$KEYDIR/ddns-admin.key" ] || newkey ddns-admin "$KEYDIR/ddns-admin.key"
  [ -f "$LIST" ] || : > "$LIST"
  protect "$LIST"
  regen
  apply || die "generated config rejected by named-checkconf"
  echo "initialised: $(names | grep -c . || true) router(s)"
}

cmd_add() {
  local n="${1:-}"; valid_name "$n"
  [ -f "$GEN" ] || die "run 'ddns-router init' first"
  known "$n" && die "'$n' already exists"
  [ -e "$KEYDIR/$n.key" ] && die "stale key file $KEYDIR/$n.key exists — remove it first"

  newkey "$n" "$KEYDIR/$n.key"
  snapshot
  write_list $(names) "$n" \
    || { rm -f "$KEYDIR/$n.key" "$LIST.bak"; die "could not write routers.list — nothing changed"; }
  regen
  if ! apply; then
    restore; rm -f "$KEYDIR/$n.key"
    die "config rejected — rolled back, nothing changed"
  fi
  rm -f "$LIST.bak"

  # Check the new key is accepted (prerequisite-only update: changes nothing)
  if running && ! nsupdate -k "$KEYDIR/$n.key" >/dev/null 2>&1 <<EOF
server $BIND_IP
zone $ZONE
prereq yxdomain $ZONE
send
EOF
  then warn "BIND did not accept the new key yet — check the logs"; fi

  echo "added $n"
  cmd_show "$n"
}

cmd_remove() {
  local n="${1:-}" answer; valid_name "$n"
  known "$n" || die "unknown router '$n'"
  read -r -p "Remove $n.$ZONE and revoke its key? Type the name to confirm: " answer
  [ "$answer" = "$n" ] || die "aborted"

  # Revoke first; only delete the record once the new config is live,
  # so a rejected config rolls back with nothing lost.
  snapshot
  write_list $(names | grep -vx -- "$n" || true) \
    || { rm -f "$LIST.bak"; die "could not write routers.list — nothing changed"; }
  regen
  if ! apply; then restore; die "config rejected — rolled back, nothing changed"; fi
  rm -f "$LIST.bak" "$KEYDIR/$n.key"

  if running; then
    nsupdate -k "$KEYDIR/ddns-admin.key" <<EOF || warn "key revoked, but the DNS record could not be deleted"
server $BIND_IP
zone $ZONE
update delete $n.$ZONE.
send
EOF
  fi
  echo "removed $n (key revoked)"
}

cmd_show() {
  local n="${1:-}" secret; valid_name "$n"
  known "$n" || die "unknown router '$n'"
  secret=$(secret_of "$n")
  [ -n "$secret" ] || die "no secret found in $KEYDIR/$n.key"
  cat <<EOF

Router › Services › Dynamic DNS — $n
  Service            bind-nsupdate     (firmware 07.20+ required)
  Hostname / Domain  $n.$ZONE
  DNS server         $DDNS_SERVER
  Username           hmac-sha256:$n
  Password           $secret
  IP source          Public
EOF
}

cmd_list() {
  local n ip all
  all=$(names)
  [ -n "$all" ] || { echo "no routers"; return; }
  for n in $all; do
    ip=$(dig @"$BIND_IP" "$n.$ZONE" A +short +time=2 +tries=1 2>/dev/null | head -1 || true)
    printf '%-45s %s\n' "$n.$ZONE" "${ip:-(no record yet)}"
  done
}

check_list

case "${1:-}" in
  init)   cmd_init ;;
  add)    cmd_add "${2:-}" ;;
  remove) cmd_remove "${2:-}" ;;
  show)   cmd_show "${2:-}" ;;
  list)   cmd_list ;;
  *)      usage ;;
esac
